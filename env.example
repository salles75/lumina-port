# ===========================================
# Lumina - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lumina?schema=public"

# Redis (Cache & Queue)
REDIS_URL="redis://localhost:6379"

# ===========================================
# Authentication (Clerk)
# ===========================================
# Get your keys at https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret

# Clerk URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ===========================================
# Payments (Stripe)
# ===========================================
# Get your keys at https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# Stripe Price IDs (create these in Stripe Dashboard)
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_PRO_YEARLY=price_xxx
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_xxx
STRIPE_PRICE_ENTERPRISE_YEARLY=price_xxx

# ===========================================
# Internal Services
# ===========================================
# NLP Engine (Python/FastAPI)
NLP_ENGINE_URL=http://localhost:8000
NLP_ENGINE_API_KEY=your_internal_api_key_here

# API Gateway (Node.js)
API_GATEWAY_URL=http://localhost:4000
API_GATEWAY_SECRET=your_api_gateway_secret_here

# ===========================================
# Frontend
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ===========================================
# Optional: External Services
# ===========================================
# For scraping product pages (optional)
SCRAPING_API_KEY=

# For sending emails (optional)
RESEND_API_KEY=

# ===========================================
# Development
# ===========================================
NODE_ENV=development
LOG_LEVEL=debug
